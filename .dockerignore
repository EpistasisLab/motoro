# .env first and deliberately: it holds credentials and host-side URLs
# (localhost:5453) that are wrong inside the compose network. It must not reach a
# build context, where a stray COPY could bake it into an image.
.env
.env.*
!.env.example

.venv/
# .git/ stays excluded even though the build now needs to read it. hatch-vcs
# derives the package version from the repo's tags, so docker/Dockerfile.migrate
# cannot build a wheel without that metadata -- but it arrives as a *named build
# context* (compose.yml's `additional_contexts: gitdir: ./.git`), which is a
# separate context this file does not filter. Keeping the exclusion here is the
# point: a future stray `COPY . .` can never bake the full history, and whatever
# was ever committed and later removed from it, into an image layer.
.git/
.gitignore

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Not needed to apply a schema.
tests/
examples/
scripts/
docker/
compose.yml
CLAUDE.md
