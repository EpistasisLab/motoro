# Copy to .env for local development.
#
# Ports are offset from the ARES stack (5452/6379) and the surgical stack (6432)
# so every stack can run simultaneously.

POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=motoro
POSTGRES_PORT=5453
REDIS_PORT=6381

# Read by CoreSettings via the MOTORO_ prefix (see examples/run_agent.py).
MOTORO_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/motoro
MOTORO_REDIS_URL=redis://localhost:6381/0

# Used only by the test suite; unset means the DB-backed tests skip.
MOTORO_TEST_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/motoro_test

# Provider credentials. Core's built-in resolver reads these by their bare,
# conventional names — the MOTORO_ prefix does NOT apply to them, so paste the
# same variables you would use anywhere else.
#
# Pick whichever provider you have. Foundry needs BOTH: the key does not encode
# an endpoint, and the base URL is derived from the resource name.
ANTHROPIC_API_KEY=
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
OPENAI_API_KEY=
