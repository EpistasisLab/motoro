# Copy to .env for local development.
#
# Ports are offset from the ARES stack (5452/6379) and the surgical stack (6432)
# so every stack can run simultaneously.

POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic
POSTGRES_DB=agentic_core
POSTGRES_PORT=5453
REDIS_PORT=6381

# Read by CoreSettings via the AGENTIC_ prefix (see examples/run_agent.py).
AGENTIC_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/agentic_core
AGENTIC_REDIS_URL=redis://localhost:6381/0

# Used only by the test suite; unset means the DB-backed tests skip.
AGENTIC_TEST_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/agentic_core_test

# Provider credential for examples/run_agent.py. Core reads this off the
# ModelConfig — there is no settings table and no per-user record involved.
ANTHROPIC_API_KEY=
