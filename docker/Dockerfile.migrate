# One job: prepare core's database, then exit.
#
# This is an *init container*, not an application image. Core is a headless
# library and has no app image to build — see compose.yml. The distinction that
# matters: a single container runs to completion and gates whatever comes after
# it, which is the deploy-step shape. Migrating from inside N application
# replicas is the shape that races, and this is not that.
#
# Two steps, both idempotent (`deploy` = `upgrade` then `sync-catalog`):
#
#   1. Apply the schema.
#   2. Project the pattern registry into `architectural_patterns`.
#
# Step 2 is why this installs core's full dependency set rather than the five
# packages the schema alone needs. Building the catalog means importing every
# pattern plugin to read its metadata, and the plugins import the runtime —
# litellm, instructor, opentelemetry, structlog. There is no way around it: the
# metadata lives on the plugin classes, which is the whole point of the design.
#
# So this image is ~1 GB rather than ~264 MB. If that ever matters more than
# having one deploy step, split it: `upgrade` genuinely needs nothing but Alembic
# and a driver, and
# tests/test_step0_boundary.py::test_migration_chain_stays_installable_without_runtime_deps
# keeps that true.
FROM python:3.13-slim

WORKDIR /app

# README.md is not documentation here: pyproject declares `readme = "README.md"`,
# and hatchling refuses to build the wheel without it.
COPY pyproject.toml README.md ./
COPY src/ ./src/

# The .git mount is what lets this build at all: pyproject.toml declares no
# literal version, hatch-vcs derives it from the repo's tags, and it needs the
# git metadata to do that.
#
# `from=gitdir` -- a *named* build context (compose.yml's `additional_contexts`)
# rather than the main one -- for two reasons. It never lands in an image layer,
# and .dockerignore can go on excluding .git/ from the main context, so no future
# `COPY . .` here can bake the history into an image. Building this by hand
# outside Compose therefore needs the context passed explicitly:
#
#   docker build -f docker/Dockerfile.migrate --build-context gitdir=./.git .
#
# git itself is a build-time dependency for the same reason (setuptools-scm
# shells out to `git describe`, and python:3.13-slim ships without it), so it's
# installed and removed inside this single RUN -- an init container that applies
# a schema has no runtime use for it.
RUN --mount=type=bind,from=gitdir,target=/app/.git \
    apt-get update && apt-get install -y --no-install-recommends git \
    && pip install --no-cache-dir . \
    && apt-get purge -y --auto-remove git \
    && rm -rf /var/lib/apt/lists/*

# Note what is absent: the repo's .env. CoreSettings reads `env_file=".env"`, and
# that file holds host-side URLs (localhost:5453) which are wrong inside the
# compose network. The URL arrives as DATABASE_URL from the environment instead.
# .dockerignore keeps it out of the build context so it cannot be copied by
# accident.

ENTRYPOINT ["python", "-m", "motoro.migrations"]
# `deploy`, not `upgrade`: preparing core's database means the schema *and* the
# catalog projection, which must run after the schema exists.
CMD ["deploy"]
