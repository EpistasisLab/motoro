# One job: apply core's schema, then exit.
#
# This is an *init container*, not an application image. Core is a headless
# library and has no app image to build — see compose.yml. The distinction that
# matters: a single container runs the migration to completion and gates whatever
# comes after it, which is the deploy-step shape. Migrating from inside N
# application replicas is the shape that races, and this is not that.
#
# Installed with --no-deps and an explicit dependency list rather than
# `pip install .`, because the migration chain needs almost nothing: importing
# the four model modules plus agentic_core.migrations pulls in no litellm, no
# instructor, no mcp, and no opentelemetry. Installing the full runtime would
# multiply this image's size for code that never executes here.
#
# tests/test_step0_boundary.py::test_migration_chain_stays_installable_without_runtime_deps
# fails if a model or migration ever reaches for one of those, so the day this
# list becomes wrong is the day a test says so — not the day a deploy breaks.
FROM python:3.13-slim

WORKDIR /app

# README.md is not documentation here: pyproject declares `readme = "README.md"`,
# and hatchling refuses to build the wheel without it.
COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --no-cache-dir --no-deps . \
 && pip install --no-cache-dir \
      "alembic>=1.18.4" \
      "sqlalchemy[asyncio]>=2.0.50" \
      "asyncpg>=0.30.0" \
      "pydantic>=2.10.0" \
      "pydantic-settings>=2.14.1"

# Note what is absent: the repo's .env. CoreSettings reads `env_file=".env"`, and
# that file holds host-side URLs (localhost:5453) which are wrong inside the
# compose network. The URL arrives as DATABASE_URL from the environment instead.
# .dockerignore keeps it out of the build context so it cannot be copied by
# accident.

ENTRYPOINT ["python", "-m", "agentic_core.migrations"]
CMD ["upgrade"]
